<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS shows these strings in the permission prompts. They are mandatory:
       touching the microphone or location without the matching key makes the OS
       terminate the app. Tauri merges this file into the generated Info.plist. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Materix uses the microphone for voice messages and calls.</string>
  <key>NSCameraUsageDescription</key>
  <string>Materix uses the camera for video calls.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Materix uses your location only when you choose to share it in a chat.</string>
</dict>
</plist>
